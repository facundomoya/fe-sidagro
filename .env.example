# Configuración del frontend de SID-Agro.
# Copiar este archivo como .env.local y ajustar los valores según el entorno.
# .env.local está ignorado por Git. No incluir credenciales ni tokens en estos archivos.
# Después de modificar .env.local, reiniciar el frontend (npm run dev).

# URL base del backend de SID-Agro, sin barra final.
# Backend en la misma computadora:
VITE_API_URL=http://localhost:3000
# Backend en otra computadora de la red (reemplazar por su IP y puerto):
# VITE_API_URL=http://192.168.0.10:3000
